#!/usr/bin/env bash
# Pre-commit gate: delegates to `cargo xtask precommit` which runs
# fmt, clippy, rustdoc, and typos checks.
#
# Bypass with `git commit --no-verify` for WIP commits.

set -euo pipefail

# Skip the hook entirely for non-Rust commits.
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs' '*.toml' | tr '\n' ' ')
if [[ -z "$files" ]]; then
    exit 0
fi

exec cargo xtask precommit
