# Ingest and egress are not the same shape.
#
# A real deployment configures them separately: a restreamer's ingest is a
# few high-bitrate contributors onto pooled listener sockets, while its
# egress fans out to many subscribers. Holding the two ends equal -- which
# is all the CLI could express until now -- conflates them and hides
# whichever one is the constraint.
#
# Keys outside any section apply to BOTH roles and move in lockstep, so
# the cell count is unchanged. Keys under [recv] / [send] make that axis
# independent for that role, which is a genuine cartesian product.
#
# `ingress` is deliberately NOT split here (and the harness will now
# hard-error if you try): the caller uses it only to compute which port
# to dial, so it must match whatever the listener actually bound, or
# connections just fail. Set it once, unscoped.
#
#   srt-bench matrix --plan docs/plans/asymmetric-roles.plan --secs 10 --out scratch/roles.tsv

runtime             = tokio
connections         = 400
# `bitrate` is the SOURCE PAYLOAD rate the application produces. SRT's
# pacing is configured separately and explicitly below: `input-relative:25`
# sets SRTO_INPUTBW to that source rate with a 25% SRTO_OHEADBW allowance,
# so the protocol has headroom to carry the workload plus retransmission
# rather than pacing fractionally below it (which is what the historical
# `legacy-source-fixed` coupling of the two numbers did).
bitrate             = 8000000
srt-bandwidth       = input-relative:25
promotion           = all
connect-concurrency = 50
sock-buf            = 16m
ingress             = shared-pool:4

# The listener: pooled sockets, swept over how many threads serve them.
# 1 is the historical single-threaded control; it is also a hard ceiling.
[recv]
workers             = 1,2,3
cpus                = 0-2

# The load generator: held at a level already shown to saturate a
# single-threaded listener, so what moves is the listener's capacity and
# not the offered load. Disjoint CPUs so the two ends cannot take cores
# from each other.
[send]
workers             = 3
cpus                = 3-5
