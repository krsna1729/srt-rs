# Capacity frontier sweep across scale and bitrate curves.
runtime             = mio,tokio
ingress             = shared-pool:4
egress              = per-connection
encryption          = plain
connections         = 50,200,600,1200
# `bitrate` is the SOURCE PAYLOAD rate the application produces. SRT's
# pacing is configured separately and explicitly below: `input-relative:25`
# sets SRTO_INPUTBW to that source rate with a 25% SRTO_OHEADBW allowance,
# so the protocol has headroom to carry the workload plus retransmission
# rather than pacing fractionally below it (which is what the historical
# `legacy-source-fixed` coupling of the two numbers did).
bitrate             = 1000000,4000000,8000000
srt-bandwidth       = input-relative:25

workers             = 1
promotion           = all
cookie-routing      = on
batch               = on
sock-buf            = 16m
bond                = none
connect-concurrency = 50
pin                 = off
