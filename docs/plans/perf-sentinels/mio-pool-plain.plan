# Fast sentinel: plain packet path plus pooled mio ingress at connection scale.
runtime             = mio
ingress             = shared-pool:4
egress              = per-connection
encryption          = plain
connections         = 600
bitrate             = 1000000
workers             = 1
promotion           = all
cookie-routing      = on
batch               = on
sock-buf            = 16m
connect-concurrency = 50
bond                = none
pin                 = off
