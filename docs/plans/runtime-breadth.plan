# Controlled all-six-runtime breadth experiment across execution models.
# Evaluates pre/post DSA effects under identical topology and workload.
runtime             = mio,tokio,smol,monoio,glommio,compio
ingress             = shared-pool:4
egress              = per-connection
encryption          = plain
connections         = 50,200,600
bitrate             = 1000000,8000000

workers             = 1
promotion           = all
cookie-routing      = on
batch               = on
sock-buf            = 16m
bond                = none
connect-concurrency = 50
pin                 = off
